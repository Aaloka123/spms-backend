# ---------- Gmail SMTP (OTP emails) ----------
# Use MedNexus Gmail + App Password (16 chars, NO spaces)
# NOT your personal Gmail if you want From: MedNexus <mednexusnepal@gmail.com>
EMAIL_USER=mednexusnepal@gmail.com
EMAIL_PASS=gspnaanybrmgypwx
MAIL_FROM=mednexusnepal@gmail.com
MAIL_FROM_NAME=MedNexus
# Optional logo in OTP HTML (Cloudinary). Leave blank for text-only brand header.
MAIL_LOGO_URL=https://res.cloudinary.com/dzwm4gi2n/image/upload/mednexus/mednexus-logo.png

# ---------- JWT ----------
# Must be at least 32 characters for HS256
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# ---------- Default ADMIN user (seeded / synced from these values) ----------
ADMIN_EMAIL=mednexusnepal@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password
